# Optional Neon URLs. Leave both blank for local Docker development.
# Copy both from the same Neon branch, compute, and database.
# DATABASE_URL uses connection pooling; DATABASE_URL_UNPOOLED uses a direct connection.
# Standard postgresql:// and postgres:// URLs are accepted and use psycopg 3.
# Remote SSL is strengthened to verify-full, using your system CA bundle.
# Preserve channel_binding=require when it is present in the copied URL.
DATABASE_URL= 
DATABASE_URL_UNPOOLED= 

# Existing local Docker settings. Keep your current password when upgrading.
CALORIE_DB_HOST=127.0.0.1
CALORIE_DB_PORT=5433
CALORIE_DB_NAME=calorie_tracker
CALORIE_DB_USER=calorie_app
CALORIE_DB_PASSWORD=replace_with_your_local_password

CALORIE_COOKIE_SECURE=false
CALORIE_ALLOWED_ORIGINS=http://127.0.0.1:5174,http://localhost:5174,http://127.0.0.1:8001,http://localhost:8001
